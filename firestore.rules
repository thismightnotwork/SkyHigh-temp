rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /joinApplications/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId && !('hqStaff' in request.resource.data.diff(resource.data).changedKeys()) && !('discordRoleSynced' in request.resource.data.diff(resource.data).changedKeys()) && !('atcRating' in request.resource.data.diff(resource.data).changedKeys()) && !('pilotRating' in request.resource.data.diff(resource.data).changedKeys()) && !('awards' in request.resource.data.diff(resource.data).changedKeys());
      allow delete: if false;
    }
    match /meta/cidCounter {
      allow read, write: if request.auth != null;
    }
    match /events/{eventId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
